# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Play upload signing (NEVER commit secrets)
credentials/**
!credentials/keystore.properties.example
*.keystore
*.p12

# release artifacts
dist/
*.aab
*.apk
!android/app/debug.keystore

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# large stress-test backups (regenerate via samples/generate-heavy-backup.js)
samples/tutoring-backup-heavy.json

# local emulator / UI dump captures (never commit)
.android-*.png
.android-*.xml
.emu-*.txt
android-*.txt
prebuild-rename.txt
tmp-splash*.png
