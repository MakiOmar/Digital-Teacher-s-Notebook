{
  "expo": {
    "name": "دفتر المعلم الرقمي",
    "slug": "tutoring-manager",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tutoringmanager",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#B5E2F0"
    },
    "locales": {
      "ar": "./locales/ar.json"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itqandev.digitalteachernotebook",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.itqandev.digitalteachernotebook",
      "versionCode": 8,
      "supportsRtl": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#12537C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#B5E2F0",
          "imageWidth": 280
        }
      ],
      "./plugins/withFullBleedSplash.js",
      "./plugins/withLocalizationForcesRtl.js",
      "./plugins/withGradleConfigurationCache.js",
      "./plugins/withAndroidReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidEmulatorSupport.js",
      "./plugins/withR8Optimization.js",
      "expo-secure-store",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح للتطبيق بالوصول إلى صورك لوضع صورة المدرس.",
          "cameraPermission": "السماح للتطبيق باستخدام الكاميرا لالتقاط صورة المدرس."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "السماح للتطبيق بالوصول إلى جهات الاتصال لإضافة أرقام الطلاب وأولياء الأمور بسرعة."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "السماح للتطبيق باستخدام Face ID لقفل التطبيق."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
